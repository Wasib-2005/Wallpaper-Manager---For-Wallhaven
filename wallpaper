#!/usr/bin/env python3

import argparse
import json
import os
import platform
import random
import signal
import subprocess
import sys
import time
import urllib.parse
import urllib.request

# Directory & File Paths
CONFIG_DIR = os.path.expanduser("~/.config/wallhaven")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
LOG_FILE = os.path.join(CONFIG_DIR, "wallpaper.log")
PID_FILE = os.path.join(CONFIG_DIR, "wallpaper.pid")
TRIGGER_FILE = os.path.join(CONFIG_DIR, "reload.flag")
SAVE_DIR = os.path.expanduser("~/Pictures/Wallhaven")


def parse_size_to_bytes(size_str):
    """Converts strings like '1MB', '500KB', '1GB' into integer bytes."""
    if not size_str or str(size_str).strip().lower() in ("", "none"):
        return None

    s = str(size_str).strip().upper()
    units = {"KB": 1024, "MB": 1024**2, "GB": 1024**3, "B": 1}

    for unit, multiplier in units.items():
        if s.endswith(unit):
            try:
                number = float(s[:-len(unit)].strip())
                return int(number * multiplier)
            except ValueError:
                return None
    try:
        # Fallback if user passes raw numbers (assumes MB)
        return int(float(s) * 1024**2)
    except ValueError:
        return None


def rotate_log_if_needed():
    """Truncates log file if it exceeds maximum size (Default: 5 MB)."""
    if not os.path.exists(LOG_FILE):
        return

    config = load_config()
    raw_limit = config.get("max_log_size", "5MB")
    max_bytes = parse_size_to_bytes(raw_limit) or (5 * 1024 * 1024)

    try:
        if os.path.getsize(LOG_FILE) >= max_bytes:
            with open(LOG_FILE, "r") as f:
                lines = f.readlines()

            # Keep only the last 100 log entries
            retained_lines = lines[-100:]
            timestamp = time.strftime("[%Y-%m-%d %H:%M:%S]")
            retained_lines.append(f"{timestamp} 🧹 Log exceeded {raw_limit} limit and was truncated.\n")

            with open(LOG_FILE, "w") as f:
                f.writelines(retained_lines)
    except Exception:
        pass


def log(msg):
    """Prints message to console and writes to log file with rotation."""
    rotate_log_if_needed()
    timestamp = time.strftime("[%Y-%m-%d %H:%M:%S]")
    entry = f"{timestamp} {msg}"
    print(entry)
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(entry + "\n")
    except Exception as e:
        print(f"⚠️ Failed to write to log: {e}")


def load_config():
    """Loads saved settings."""
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_config(new_settings):
    """Merges and saves settings to config file; removes keys set to empty or 'none'."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    current = load_config()

    for k, v in new_settings.items():
        if v is None:
            continue

        val_str = str(v).strip().lower()
        if val_str in ("", "none", "0", "0.0"):
            current.pop(k, None)  # Delete setting if set to empty or 'none'
        else:
            current[k] = v

    with open(CONFIG_FILE, "w") as f:
        json.dump(current, f, indent=4)
    return current


def get_active_pid():
    """Returns PID of active background process if running."""
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return pid
        except (OSError, ValueError):
            if os.path.exists(PID_FILE):
                os.remove(PID_FILE)
    return None


def show_logs(follow=False):
    """Displays log file content."""
    if not os.path.exists(LOG_FILE):
        print("ℹ️ No log file found yet.")
        return

    if follow:
        print(f"📡 Streaming logs live ({LOG_FILE}). Press Ctrl+C to stop...\n")
        try:
            with open(LOG_FILE, "r") as f:
                f.seek(0, os.SEEK_END)
                while True:
                    line = f.readline()
                    if not line:
                        time.sleep(0.5)
                        continue
                    print(line, end="")
        except KeyboardInterrupt:
            print("\n👋 Stopped watching logs.")
    else:
        print(f"=== Wallhaven Logs ({LOG_FILE}) ===")
        try:
            with open(LOG_FILE, "r") as f:
                lines = f.readlines()
                print("".join(lines[-50:]))
        except Exception as e:
            print(f"❌ Error reading logs: {e}")


def stop_daemon():
    """Stops running background process."""
    pid = get_active_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            if os.path.exists(PID_FILE):
                os.remove(PID_FILE)
            log(f"🛑 Stopped background wallpaper service (PID: {pid}).")
        except Exception as e:
            print(f"❌ Failed to stop process: {e}")
    else:
        print("ℹ️ No background wallpaper process is currently running.")


def trigger_immediate_refresh():
    """Signals the running daemon to change wallpaper immediately."""
    pid = get_active_pid()
    if not pid:
        print("🔴 No background service running.")
        return

    os.makedirs(CONFIG_DIR, exist_ok=True)
    open(TRIGGER_FILE, "w").close()

    if hasattr(signal, "SIGHUP"):
        try:
            os.kill(pid, signal.SIGHUP)
        except ProcessLookupError:
            pass

    print("⚡ Triggered immediate wallpaper refresh on running daemon!")


def start_daemon():
    """Spawns the script in the background."""
    pid = get_active_pid()
    if pid:
        print(f"🔄 Existing daemon found (PID: {pid}). Restarting with new settings...")
        stop_daemon()
        time.sleep(0.5)

    clean_args = [
        arg for arg in sys.argv
        if arg not in ["-D", "--daemon", "-LOG", "--log", "-f", "--follow", "--now", "--status"]
    ]
    cmd = [sys.executable] + clean_args

    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(LOG_FILE, "a") as log_out:
        process = subprocess.Popen(
            cmd,
            stdout=log_out,
            stderr=log_out,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )

    with open(PID_FILE, "w") as f:
        f.write(str(process.pid))

    print(f"🚀 Wallpaper service running in background (PID: {process.pid}).")
    print("📄 View logs anytime with: wallpaper -LOG")
    sys.exit(0)


def fetch_wallpaper_url(args, config):
    """Fetches wallpaper URL using active config and CLI args."""
    api_key = args.key.strip() if args.key is not None else config.get("api_key", "").strip()
    query = args.query.strip() if args.query is not None else config.get("query", "")

    res_arg = args.resolution if args.resolution is not None else config.get("resolution", "1920x1080")
    resolution = res_arg.replace("*", "x")

    ratio = args.ratio if args.ratio is not None else config.get("ratio", "16x9,16x10,21x9")

    params = {
        "categories": args.categories if args.categories is not None else config.get("categories", "111"),
        "purity": args.purity if args.purity is not None else config.get("purity", "100"),
        "sorting": args.sort if args.sort is not None else config.get("sort", "random"),
        "order": "desc",
        "atleast": resolution,
        "ratios": ratio,
    }

    if api_key and api_key.lower() != "none":
        params["apikey"] = api_key

    if query and query.lower() != "none":
        params["q"] = query

    if params["sorting"] == "toplist":
        params["topRange"] = args.top_range if args.top_range is not None else config.get("top_range", "1M")

    url = f"https://wallhaven.cc/api/v1/search?{urllib.parse.urlencode(params)}"

    req = urllib.request.Request(
        url,
        headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) WallpaperFetcher/1.0"},
    )

    try:
        with urllib.request.urlopen(req) as response:
            data = json.loads(response.read().decode("utf-8"))
            wallpapers = data.get("data", [])

            if not wallpapers:
                log("❌ No wallpapers found matching current criteria.")
                return None, None

            selected = random.choice(wallpapers[:15]) if params["sorting"] != "random" else wallpapers[0]

            image_url = selected["path"]
            image_id = selected["id"]
            extension = os.path.splitext(image_url)[1]

            return image_url, f"wallhaven-{image_id}{extension}"

    except urllib.error.HTTPError as e:
        if e.code == 401:
            log("❌ HTTP 401 Unauthorized: Invalid or missing API Key for NSFW content.")
        else:
            log(f"❌ Wallhaven API Error: HTTP {e.code}")
        return None, None
    except Exception as e:
        log(f"❌ Error communicating with Wallhaven API: {e}")
        return None, None


def download_image(url, save_path):
    log(f"📥 Downloading: {url}")
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req) as response, open(save_path, "wb") as f:
        f.write(response.read())


def cleanup_old_wallpapers(max_keep):
    if max_keep <= 0: return
    try:
        files = [os.path.join(SAVE_DIR, f) for f in os.listdir(SAVE_DIR) if os.path.isfile(os.path.join(SAVE_DIR, f))]
        files.sort(key=os.path.getmtime, reverse=True)
        for old_file in files[max_keep:]:
            os.remove(old_file)
            log(f"🗑️ Cleaned up old wallpaper: {os.path.basename(old_file)}")
    except Exception as e:
        log(f"⚠️ Cleanup error: {e}")


def set_desktop_wallpaper(image_path):
    os_name = platform.system()
    abs_path = os.path.abspath(image_path)

    if os_name == "Windows":
        import ctypes
        ctypes.windll.user32.SystemParametersInfoW(20, 0, abs_path, 3)
        log("🖥️ Wallpaper applied (Windows).")

    elif os_name == "Darwin":
        script = f'tell application "System Events" to set picture of every desktop to "{abs_path}"'
        subprocess.run(["osascript", "-e", script])
        log("🖥️ Wallpaper applied (macOS).")

    elif os_name == "Linux":
        desktop_env = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()

        if "kde" in desktop_env:
            try:
                res = subprocess.run(["plasma-apply-wallpaperimage", abs_path], capture_output=True, text=True)
                if res.returncode == 0:
                    log("🖥️ Wallpaper applied (KDE).")
                    return
            except FileNotFoundError:
                pass

            script = f"""
            var allDesktops = desktops();
            for (i=0;i<allDesktops.length;i++) {{
                d = allDesktops[i];
                d.wallpaperPlugin = "org.kde.image";
                d.currentConfigGroup = Array("Wallpaper", "org.kde.image", "General");
                d.writeConfig("Image", "file://{abs_path}");
            }}
            """
            for qdbus_cmd in ["qdbus", "qdbus6", "qdbus-qt6", "qdbus-qt5"]:
                try:
                    res = subprocess.run([qdbus_cmd, "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script], capture_output=True)
                    if res.returncode == 0:
                        log(f"🖥️ Wallpaper applied (KDE - {qdbus_cmd}).")
                        return
                except FileNotFoundError:
                    continue

        elif "gnome" in desktop_env or "ubuntu" in desktop_env:
            uri = f"file://{abs_path}"
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri", uri])
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", uri])
            log("🖥️ Wallpaper applied (GNOME).")
        else:
            try:
                subprocess.run(["feh", "--bg-fill", abs_path])
                log("🖥️ Wallpaper applied (feh).")
            except FileNotFoundError:
                log("⚠️ Saved wallpaper locally.")


def run_cycle(args, config):
    os.makedirs(SAVE_DIR, exist_ok=True)
    img_url, filename = fetch_wallpaper_url(args, config)

    if img_url and filename:
        file_path = os.path.join(SAVE_DIR, filename)
        download_image(img_url, file_path)
        set_desktop_wallpaper(file_path)
        cleanup_old_wallpapers(args.keep)


def interruptible_sleep(seconds):
    end_time = time.time() + seconds
    while time.time() < end_time:
        if os.path.exists(TRIGGER_FILE):
            try: os.remove(TRIGGER_FILE)
            except OSError: pass
            return True
        time.sleep(0.5)
    return False


def main():
    parser = argparse.ArgumentParser(
        description="Wallhaven Desktop Wallpaper CLI\nFetches and applies desktop wallpapers seamlessly.",
        formatter_class=argparse.RawTextHelpFormatter
    )

    parser.add_argument("-Q", "--query", type=str, default=None, help="""Search term(s) for wallpapers.
Examples: 'nature', 'cyberpunk', '-anime' (exclude anime)""")

    parser.add_argument("-T", "--timer", type=float, default=None, help="""Refresh timer in minutes.
Examples: '30' (30 mins), '0.5' (30 seconds)""")

    parser.add_argument("-R", "--resolution", type=str, default=None, help="""Minimum resolution.
Examples: '1920x1080', '2560x1440', '3840x2160'""")

    parser.add_argument("-A", "--ratio", type=str, default=None, help="""Aspect ratio(s) separated by commas.
Examples: '16x9', '21x9', '16x9,21x9,16x10'""")

    parser.add_argument("-K", "--key", type=str, default=None, help="""Your Wallhaven API Key.
(Required if you want to view NSFW/001 content)""")

    parser.add_argument("-P", "--purity", type=str, default=None, help="""Purity bitmask (SFW / Sketchy / NSFW).
  100 = SFW only (Default)
  010 = Sketchy only
  001 = NSFW only (Requires API Key!)
  111 = All (SFW + Sketchy + NSFW)
  110 = SFW + Sketchy
  101 = SFW + NSFW""")

    parser.add_argument("-C", "--categories", type=str, default=None, help="""Category bitmask (General / Anime / People).
  100 = General only
  010 = Anime only
  001 = People only
  111 = All (Default)
  110 = General + Anime""")

    parser.add_argument("-S", "--sort", type=str, default=None, help="""Sorting method.
Options: random, date_added, relevance, views, favorites, toplist, hot""")

    parser.add_argument("--top-range", type=str, default=None, help="""Timeframe if sort is 'toplist'.
Options: 1d, 3d, 1w, 1M, 3M, 6M, 1y""")

    parser.add_argument("-M", "--keep", type=int, default=1, help="""Max downloaded images to keep in folder.
(Default: 1 - Automatically deletes old wallpapers)""")

    parser.add_argument("-L", "--max-log-size", type=str, default=None, help="""Maximum log file size limit.
Examples: '500KB', '1MB', '5MB' (Default), '1GB', 'none'""")

    # Service & Management Flags
    service_group = parser.add_argument_group('Service & Management Commands')
    service_group.add_argument("-D", "--daemon", action="store_true", help="Run as a background service using your timer")
    service_group.add_argument("-LOG", "--log", action="store_true", help="Show recent background service logs")
    service_group.add_argument("-f", "--follow", action="store_true", help="Live stream the background service logs")
    service_group.add_argument("--now", action="store_true", help="Force running background service to change wallpaper NOW")
    service_group.add_argument("--set", action="store_true", help="Only save passed arguments to config (don't run)")
    service_group.add_argument("--stop", action="store_true", help="Stop the background service")
    service_group.add_argument("--status", action="store_true", help="Check if the background service is running")

    args = parser.parse_args()

    def handle_sighup(signum, frame):
        open(TRIGGER_FILE, "w").close()

    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, handle_sighup)

    if args.log:
        show_logs(follow=args.follow)
        sys.exit(0)
    if args.now:
        trigger_immediate_refresh()
        sys.exit(0)
    if args.stop:
        stop_daemon()
        sys.exit(0)
    if args.status:
        pid = get_active_pid()
        if pid: print(f"🟢 Wallpaper service is RUNNING in background (PID: {pid}).")
        else: print("🔴 Wallpaper service is STOPPED.")
        sys.exit(0)

    # Save to config if explicit CLI flags were passed
    new_cfg = {}
    if args.key is not None: new_cfg["api_key"] = args.key
    if args.query is not None: new_cfg["query"] = args.query
    if args.timer is not None: new_cfg["timer"] = args.timer
    if args.resolution is not None: new_cfg["resolution"] = args.resolution
    if args.ratio is not None: new_cfg["ratio"] = args.ratio
    if args.purity is not None: new_cfg["purity"] = args.purity
    if args.sort is not None: new_cfg["sort"] = args.sort
    if args.categories is not None: new_cfg["categories"] = args.categories
    if args.top_range is not None: new_cfg["top_range"] = args.top_range

    if args.max_log_size is not None:
        parsed = parse_size_to_bytes(args.max_log_size)
        if parsed is not None or str(args.max_log_size).strip().lower() in ("", "none"):
            new_cfg["max_log_size"] = args.max_log_size
        else:
            print("⚠️ Invalid log size format. Use units like 500KB, 5MB, 1GB.")

    if new_cfg or args.set:
        config = save_config(new_cfg)
        log("⚙️ Updated configuration file.")
        if args.set:
            sys.exit(0)
    else:
        config = load_config()

    if args.daemon:
        start_daemon()

    timer_val = args.timer if (args.timer is not None and args.timer > 0) else float(config.get("timer", 0.0))

    if timer_val > 0:
        sleep_seconds = timer_val * 60
        log(f"🔄 Wallpaper service running (Timer: {timer_val}m / {sleep_seconds:.1f}s).")
        try:
            while True:
                active_config = load_config()
                run_cycle(args, active_config)
                interrupted = interruptible_sleep(sleep_seconds)
                if interrupted: log("⚡ Immediate refresh requested via trigger.")
        except KeyboardInterrupt:
            log("👋 Wallpaper service stopped.")
    else:
        run_cycle(args, config)

if __name__ == "__main__":
    main()
